    {
      "parameters": {
        "jsCode": "// Weekly digest: one email, riskiest accounts first\nconst accounts = $input.all()\n  .map(i => i.json)\n  .sort((a, b) => Number(a.health_score) - Number(b.health_score));\n\nconst fmt = n => Number(n || 0).toLocaleString('en-US');\nconst arrInPlay = accounts.reduce((sum, a) => sum + Number(a.arr_eur || 0), 0);\nconst atRisk = accounts.filter(a => a.health_tier === 'At Risk').length;\n\nconst cards = accounts.map(a => `\n  <h3 style=\"margin:24px 0 4px\">${a.account_name} · ${a.health_tier} (${a.health_score}/100)</h3>\n  <p style=\"margin:0 0 8px\"><b>ARR:</b> EUR ${fmt(a.arr_eur)} · <b>Renewal in:</b> ${a.days_to_renewal} days · <b>Owner:</b> ${a.csm_owner}</p>\n  <p style=\"margin:0 0 8px\"><b>Risk drivers:</b> ${a.risk_drivers}</p>\n  <div style=\"white-space:pre-wrap;background:#f6f6f6;padding:12px;border-radius:6px\">${a.ai_brief}</div>\n`).join('<hr>');\n\nreturn [{\n  json: {\n    subject: `Customer Health Digest: ${accounts.length} accounts need attention (EUR ${fmt(arrInPlay)} ARR)`,\n    html: `<h2>Weekly Customer Health Digest</h2>\n<p>${accounts.length} accounts flagged, ${atRisk} at risk, EUR ${fmt(arrInPlay)} ARR in play.</p>\n${cards}`\n  }\n}];"
      },
