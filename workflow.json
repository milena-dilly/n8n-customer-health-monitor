    {
      "parameters": {
        "jsCode": "// Customer Health Score: 0-100, five weighted signals\nconst today = new Date();\nconst daysBetween = (a, b) => Math.round((b - a) / 86400000);\n\nreturn $input.all().map(item => {\n  const c = item.json;\n  const seats = Number(c.seats_purchased) || 1;\n  const active = Number(c.active_users_30d) || 0;\n  const execNow = Number(c.executions_30d) || 0;\n  const execPrev = Number(c.executions_prev_30d) || 0;\n  const tickets = Number(c.support_tickets_30d) || 0;\n  const daysSinceContact = daysBetween(new Date(c.last_contact_date), today);\n  const daysToRenewal = daysBetween(today, new Date(c.renewal_date));\n\n  // 1. Adoption: share of purchased seats active in the last 30 days (35 pts)\n  const adoptionRate = Math.min(active / seats, 1);\n  const adoptionScore = adoptionRate * 35;\n\n  // 2. Usage trend: executions vs. previous 30 days (25 pts, 12.5 = flat)\n  const trend = execPrev > 0 ? (execNow - execPrev) / execPrev : 0;\n  const trendScore = Math.max(0, Math.min(25, 12.5 + trend * 25));\n\n  // 3. Support load (15 pts)\n  const supportScore = tickets <= 1 ? 15 : tickets <= 3 ? 10 : tickets <= 6 ? 5 : 0;\n\n  // 4. Engagement recency (15 pts)\n  const contactScore = daysSinceContact <= 30 ? 15 : daysSinceContact <= 60 ? 8 : 0;\n\n  // 5. Renewal proximity (10 pts)\n  const renewalScore = daysToRenewal > 120 ? 10 : daysToRenewal > 60 ? 6 : 2;\n\n  const score = Math.round(adoptionScore + trendScore + supportScore + contactScore + renewalScore);\n  const tier = score >= 70 ? 'Healthy' : score >= 45 ? 'Watch' : 'At Risk';\n\n  const drivers = [];\n  if (adoptionRate < 0.5) drivers.push(`Low adoption: ${active}/${seats} seats active`);\n  if (trend < -0.2) drivers.push(`Usage down ${Math.round(Math.abs(trend) * 100)}% vs. previous 30 days`);\n  if (tickets > 3) drivers.push(`${tickets} support tickets in 30 days`);\n  if (daysSinceContact > 60) drivers.push(`No CSM contact in ${daysSinceContact} days`);\n  if (daysToRenewal <= 90) drivers.push(`Renewal in ${daysToRenewal} days`);\n\n  return {\n    json: {\n      ...c,\n      health_score: score,\n      health_tier: tier,\n      adoption_rate_pct: Math.round(adoptionRate * 100),\n      usage_trend_pct: Math.round(trend * 100),\n      days_since_contact: daysSinceContact,\n      days_to_renewal: daysToRenewal,\n      risk_drivers: drivers.join('; ') || 'None'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
